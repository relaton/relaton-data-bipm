# frozen_string_literal: true

# Deploy-time bundle for the GitHub Pages index build (data-deploy.yml).
#
# The reusable workflow points BUNDLE_GEMFILE at this file, so this is the ONE
# bundle `bundle exec jekyll build` resolves against. It layers the Jekyll
# toolchain on top of the data repo's OWN Gemfile: `eval_gemfile` pulls in that
# repo's relaton + pubid pins (each relaton-data-* repo already pins the right
# flavor of `pubid`). That gives the build BOTH Jekyll AND pubid in one bundle,
# so the theme's jekyll-index plugin can reconstruct pubid-structured DocIDs
# (Pubid::<Flavor>::Identifier.from_hash(...)) instead of degrading to a compact
# fallback id. One shared file works for every flavor — no per-repo pins are
# duplicated here, so this stays byte-identical Cimas plumbing.
#
# No `source` line: the eval'd repo Gemfile already declares rubygems.org, and a
# second primary source triggers bundler's multi-source warning.
eval_gemfile File.expand_path("Gemfile", __dir__)

# Jekyll itself. Keep this version aligned with the theme's expectations.
gem "jekyll", "~> 4.3.2"

# Ruby 3.4 dropped csv from the default gems; jekyll requires it at load time,
# so it must be an explicit bundle dependency or `bundle exec jekyll` fails with
# a LoadError.
gem "csv"

# kramdown v2 ships without the gfm parser by default.
gem "kramdown-parser-gfm"

gem "webrick", "~> 1.7"

# If you have any plugins, put them here!
group :jekyll_plugins do
  gem "jekyll-paginate"
end

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
# and associated library.
install_if -> { RUBY_PLATFORM =~ %r!mingw|mswin|java! } do
  gem "tzinfo", "~> 1.2"
  gem "tzinfo-data"
end

# Performance-booster for watching directories on Windows
gem "wdm", "~> 0.1.0", :install_if => Gem.win_platform?

# Lock `http_parser.rb` gem to `v0.6.x` on JRuby builds since newer versions of
# the gem do not have a Java counterpart.
gem "http_parser.rb", "~> 0.6.0", :platforms => [:jruby]
